{
    "name": "fly-dbh-studio",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "dev": "node dev.mjs",
        "dev:astro": "astro dev",
        "dev:api": "nodemon ./server/main.mjs --watch",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "astro:upgrade": "npx @astrojs/upgrade",
