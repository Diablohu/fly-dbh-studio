        "astro": "^5.16.0",
        "axios": "^1.13.2",
        "classnames": "^2.5.1",
        "dayjs": "^1.11.19",
        "debug": "^4.4.3",
        "express": "^5.1.0",
        "express-ws": "^5.0.2",
        "less": "^4.4.2",
        "md5": "^2.3.0",
        "msfs-simconnect-api-wrapper": "^4.7.0",
        "nanostores": "^1.1.0",
        "normalize.css": "^8.0.1",
        "numeral": "^2.0.6",
        "obs-websocket-js": "^5.0.7",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
